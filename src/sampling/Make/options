EXE_INC = \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/surfMesh/lnInclude \
    -I$(LIB_SRC)/fileFormats/lnInclude \
    -I$(LIB_SRC)/triSurface/lnInclude \
    -I$(LIB_SRC)/tracking/lnInclude \
    -I$(LIB_SRC)/lagrangian/basic/lnInclude

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -lsurfMesh \
    -lfileFormats \
    -ltriSurface \
    -llagrangian

# PE/COFF does not resolve these inline particle-method symbols transitively
# through lagrangian.dll; record the direct dependency.
ifeq ($(WM_ARCH),mingw64)
LIB_LIBS += -ltracking
endif
