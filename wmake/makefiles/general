#------------------------------------------------------------------------------
# The Makefile uses a POSIX shell
#------------------------------------------------------------------------------

SHELL           = /bin/sh


#------------------------------------------------------------------------------
# Unset suffices list (suffix rules are not used)
#------------------------------------------------------------------------------

.SUFFIXES:


#------------------------------------------------------------------------------
# Set the directory containing the wmake scripts
#------------------------------------------------------------------------------

WM_SCRIPTS      = $(WM_DIR)/scripts


#------------------------------------------------------------------------------
# Declare default paths
#------------------------------------------------------------------------------

LIB_SRC         = $(WM_PROJECT_DIR)/src
LIB_PLATFORMS   = $(WM_PROJECT_DIR)/platforms/$(WM_OPTIONS)/lib
OBJECTS_DIR     = $(MAKE_DIR)/$(WM_OPTIONS)
OPTIONS         = $(MAKE_DIR)/options
FILES           = $(MAKE_DIR)/files

SYS_INC         =
SYS_LIBS        =

PROJECT_INC     = -I$(LIB_SRC)/$(WM_PROJECT)/lnInclude \
		     -I$(LIB_SRC)/OSspecific/$(WM_OSTYPE)/lnInclude

PROJECT_LIBS    = -l$(WM_PROJECT)

EXE_INC         =
EXE_LIBS        =

LIB_LIBS        =

# For backward compatibility set FILES to $(OBJECTS_DIR)/files if it has been
# created from $(MAKE_DIR)/files that does not contain the SOURCE entry
ifneq ("$(wildcard $(OBJECTS_DIR)/files)","")
    FILES = $(OBJECTS_DIR)/files
endif


#------------------------------------------------------------------------------
# Declare default name of libraries and executables
#------------------------------------------------------------------------------

# Library
LIB             = libNULL

# Shared library extension
SO              = so

# Project executable
EXE             = $(WM_PROJECT).out

# Standalone executable
SEXE            = a.out


#------------------------------------------------------------------------------
# Set compilation and dependency building rules
#------------------------------------------------------------------------------

GENERAL_RULES = $(WM_DIR)/rules/General
include $(GENERAL_RULES)/general


#------------------------------------------------------------------------------
# Include the options file which might contain specific rules, suffixes etc.
#------------------------------------------------------------------------------

include $(OPTIONS)
include $(GENERAL_RULES)/transform


#------------------------------------------------------------------------------
# Include the files file containing the list of source files to compile
#------------------------------------------------------------------------------

include $(FILES)
ifeq ($(WM_ARCH),mingw64)
    # The Windows loader compares DLL names without case, even on case-sensitive
    # NTFS. Keep the newer Lagrangian framework distinct from legacy lagrangian.
    LIB := $(patsubst %/libLagrangian,%/libLagrangianFramework,$(LIB))
    LIB := $(patsubst %/libLagrangianFunctionObjects,%/libLagrangianFrameworkFunctionObjects,$(LIB))
    LIB_LIBS := $(patsubst -lLagrangian,-lLagrangianFramework,$(LIB_LIBS))
    LIB_LIBS := $(patsubst -lLagrangianFunctionObjects,-lLagrangianFrameworkFunctionObjects,$(LIB_LIBS))
    EXE_LIBS := $(patsubst -lLagrangian,-lLagrangianFramework,$(EXE_LIBS))
    EXE_LIBS := $(patsubst -lLagrangianFunctionObjects,-lLagrangianFrameworkFunctionObjects,$(EXE_LIBS))
    LIB_LIBS := $(filter-out -L$(FOAM_LIBBIN)/dummy,$(LIB_LIBS))
    EXE_LIBS := $(filter-out -L$(FOAM_LIBBIN)/dummy,$(EXE_LIBS))
    LIB_LIBS += -L$(FOAM_LIBBIN)/$(FOAM_MPI)
    EXE_LIBS += -L$(FOAM_LIBBIN)/$(FOAM_MPI)
    EXE := $(EXE).exe
    SEXE := $(SEXE).exe
    LIB_LIBS += -L$(FOAM_LIBBIN) $(if $(filter libOpenFOAM,$(notdir $(LIB))),,-lOpenFOAM)
    LINK_DEPS = $(if $(filter libOpenFOAM,$(notdir $(LIB))),$(FOAM_LIBBIN)/libOSspecific.o,)
    ifneq ($(LIB),libNULL)
        WINDOWS_LIBRARY_ANCHOR = $(OBJECTS_DIR)/windowsLibraryAnchor.o
        LINK_DEPS += $(WINDOWS_LIBRARY_ANCHOR)
    endif
    LINK_PRE_OBJECTS = $(LINK_DEPS)
    EXE_LINK_DEPS = $(WM_PROJECT_DIR)/platforms/windows-include/application.o

    # Match ELF --no-as-needed: registration-only DLLs must be loaded even when
    # the consumer does not call one of their model implementations directly.
    windowsLibraryPaths = $(FOAM_LIBBIN) $(FOAM_LIBBIN)/$(FOAM_MPI) $(FOAM_USER_LIBBIN) $(FOAM_SITE_LIBBIN)
    windowsAnchorPrefix = -Wl,--undefined,openfoamAnchor_
    windowsAnchors = $(foreach library,$(patsubst -l%,lib%,$(filter -l%,$1)),$(if $(wildcard $(addsuffix /$(library).dll.a,$(windowsLibraryPaths))),$(windowsAnchorPrefix)$(library)))
    LIB_LIBS := $(LIB_LIBS) $(call windowsAnchors,$(LIB_LIBS))
    EXE_LIBS := $(EXE_LIBS) $(call windowsAnchors,$(EXE_LIBS) $(PROJECT_LIBS))
endif
DEPENDENCIES=$(SOURCE:%=$(OBJECTS_DIR)/%.dep)
BASENAMES=$(basename $(SOURCE))
OBJECTS=$(BASENAMES:%=$(OBJECTS_DIR)/%.o)

# Windows CreateProcess has a command-line length limit. Keep the potentially
# large object list in a response file, using paths native tools can read.
# MinGW runs .ctors in reverse link order. Reverse the input objects to retain
# OpenFOAM's original global-initialisation order (notably dimensions/units).
ifeq ($(WM_ARCH),mingw64)
    define LINK_OBJECTS
$(file >$(OBJECTS_DIR)/link.rsp,$(shell cygpath -m $(OBJECTS) | tac))@$(shell cygpath -m $(OBJECTS_DIR)/link.rsp)
    endef
else
    LINK_OBJECTS = $(OBJECTS)
endif


#------------------------------------------------------------------------------
# Set header file include paths
#------------------------------------------------------------------------------

LIB_HEADER_DIRS = \
        $(EXE_INC) \
        -IlnInclude \
        -I. \
        $(PROJECT_INC) \
        $(GINC) \
        $(SYS_INC)


#------------------------------------------------------------------------------
# Define link statements for executables
#------------------------------------------------------------------------------

.PHONY: all
all: $(EXE)
	@:

.PHONY: silent
silent:
	@:

$(EXE): $(OBJECTS) $(WM_DIR)/makefiles/general $(EXE_LINK_DEPS)
	@$(WM_SCRIPTS)/makeTargetDir $(EXE)
	$(call QUIET_MESSAGE,ld,$(EXE))
	$E $(LINKEXE) $(LINK_OBJECTS) -L$(LIB_PLATFORMS) \
	    $(EXE_LIBS) $(PROJECT_LIBS) $(SYS_LIBS) \
	    $(LINK_LIBS) $(GLIBS) -o $(EXE)

.PHONY: exe
exe: $(SEXE) | silent

$(SEXE): $(OBJECTS) $(WM_DIR)/makefiles/general $(EXE_LINK_DEPS)
	@$(WM_SCRIPTS)/makeTargetDir $(SEXE)
	$(call QUIET_MESSAGE,ld,$(SEXE))
	$E $(LINKEXE) $(LINK_OBJECTS) $(EXE_LIBS) \
	    $(SYS_LIBS) $(LINK_LIBS) $(GLIBS) -o $(SEXE)


#------------------------------------------------------------------------------
# Define link statements for libraries
#------------------------------------------------------------------------------

.PHONY: objects
objects: $(OBJECTS) | silent

.PHONY: libso
libso: $(LIB).$(SO) | silent

$(LIB).$(SO): $(OBJECTS) $(LINK_DEPS) $(WM_DIR)/makefiles/general
	@$(WM_SCRIPTS)/makeTargetDir $(LIB)
	$(call QUIET_MESSAGE,ld,$(LIB).$(SO))
	$E $(LINKLIBSO) $(LINK_PRE_OBJECTS) $(LINK_OBJECTS) -L$(LIB_PLATFORMS) \
	    $(filter-out $(LINK_PRE_OBJECTS),$(LIB_LIBS)) $(GLIB_LIBS) -o $(LIB).$(SO)

.PHONY: lib
lib: $(LIB).a | silent

ifeq ($(WM_ARCH),mingw64)
ifneq ($(LIB),libNULL)
$(WINDOWS_LIBRARY_ANCHOR): $(WM_DIR)/src/windowsLibraryAnchor.cpp
	$(CC) -DFOAM_WINDOWS_LIBRARY=$(notdir $(LIB)) -c $< -o $@
endif
endif

$(LIB).a: $(OBJECTS)
	@$(WM_SCRIPTS)/makeTargetDir $(LIB)
	@rm -f $(LIB).a
	$(call QUIET_MESSAGE,ar,$(LIB))
	$E $(AR) $(ARFLAGS) $(LIB).a $(OBJECTS)
	$(call QUIET_MESSAGE,ranlib,$(notdir $(LIB)))
	$E $(RANLIB) $(LIB).a

.PHONY: libo
libo: $(LIB).o | silent

$(LIB).o: $(OBJECTS)
	@$(WM_SCRIPTS)/makeTargetDir $(LIB)
	@rm -f $(LIB).o
	$(call QUIET_MESSAGE,ld,$(LIB).o)
	$E $(LD) -r -o $(LIB).o $(OBJECTS)


#------------------------------------------------------------------------------
# Set rule to create the include directory for libraries
#------------------------------------------------------------------------------

lnInclude: $(MAKE_DIR)/files $(OPTIONS)
	@rm -rf lnInclude ; wmakeLnInclude .


#------------------------------------------------------------------------------
# Declare all object files depend on $(OPTIONS)
#------------------------------------------------------------------------------

$(OBJECTS): $(OPTIONS)
$(foreach S,$(SOURCE),$(eval $(OBJECTS_DIR)/$(basename $S).o : $(OBJECTS_DIR)/$S.dep))


#------------------------------------------------------------------------------
# Set dependency rule and include dependency lists
#------------------------------------------------------------------------------

.PHONY: dep
dep: $(DEPENDENCIES)

ifeq ($(findstring lnInclude,$(MAKECMDGOALS)),)
-include $(DEPENDENCIES)
endif


